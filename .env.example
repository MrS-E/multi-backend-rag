# Copy to .env and adjust as needed. Environment variables override config.yaml.
# Nested keys use the "__" delimiter (e.g. DEFAULTS__CHAT_MODEL).

# --- Model defaults ---
DEFAULTS__EMBED_MODEL=ollama/bge-m3
DEFAULTS__CHAT_MODEL=ollama/llama3.2
DEFAULTS__VISION_MODEL=ollama/llama3.2-vision
DEFAULTS__CHUNK_SIZE=700
DEFAULTS__CHUNK_OVERLAP=80
DEFAULTS__TOP_K=6
DEFAULTS__MAX_CTX_CHARS=3000

# --- Providers ---
PROVIDERS__OLLAMA__BASE_URL=http://localhost:11434
PROVIDERS__OPENAI__BASE_URL=https://api.openai.com/v1
# Name of the env var holding the OpenAI API key (not the key itself).
PROVIDERS__OPENAI__API_KEY_ENV=OPENAI_API_KEY
OPENAI_API_KEY=

# --- Auth (v1: none | api_key; oidc reserved for multi-user) ---
AUTH__PROVIDER=none
AUTH__API_KEY_ENV=RAG_API_KEY
RAG_API_KEY=
AUTH__OIDC__ISSUER=https://keycloak.example/realms/rag
AUTH__OIDC__AUDIENCE=rag-api
AUTH__OIDC__ROLES_CLAIM=groups

# --- Server ---
SERVER__HOST=0.0.0.0
SERVER__PORT=8000
SERVER__MAX_UPLOAD_MB=50

# --- Storage / infrastructure ---
STORAGE__ROOT=./storage
DATABASE_URL=sqlite:///./rag.db
REDIS_URL=redis://localhost:6379
QDRANT__HOST=localhost
QDRANT__PORT=6333

# --- Jobs ---
JOBS__KEEP_RESULT_S=3600
